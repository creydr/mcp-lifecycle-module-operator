{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>opendatahub-io/renovate-config",
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
  ],
  "commitMessagePrefix": "[{{baseBranch}}]",
  "enabledManagers": ["dockerfile", "gomod", "github-actions", "rpm-lockfile"],
  "ignorePaths": ["/docs/**"],
  "gomod": {
    "postUpdateOptions": ["gomodTidy"]
  },
  "dockerfile": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile.konflux"],
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/kubernetes-sigs/mcp-lifecycle-operator",
        "github.com/opendatahub-io/mcp-lifecycle-operator"
      ],
      "description": "Managed via operand-image.json and tools/source-update; must stay in sync with the pinned operand image",
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "gomod"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
